{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic://schemas/benchmarks/v1/detector-corpus",
  "type": "object",
  "required": ["schema_version", "id", "minimum_scores", "projects"],
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"type": "string", "minLength": 1},
    "minimum_scores": {
      "type": "object",
      "required": [
        "observation_precision_bps",
        "observation_recall_bps",
        "framework_precision_bps",
        "framework_recall_bps"
      ],
      "properties": {
        "observation_precision_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "observation_recall_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "framework_precision_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "framework_recall_bps": {"type": "integer", "minimum": 0, "maximum": 10000}
      },
      "additionalProperties": false
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "root", "provenance", "manifests", "cases"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "root": {"type": "string", "minLength": 1},
          "provenance": {
            "type": "object",
            "required": ["kind", "repository", "revision", "license"],
            "properties": {
              "kind": {"enum": ["authored-fixture", "external-snapshot"]},
              "repository": {
                "anyOf": [
                  {"type": "string", "minLength": 1},
                  {"type": "null"}
                ]
              },
              "revision": {
                "anyOf": [
                  {"type": "string", "pattern": "^[0-9a-f]{40}$"},
                  {"type": "null"}
                ]
              },
              "license": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "manifests": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "cases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path",
                "language",
                "expected_observations",
                "expected_framework_candidates"
              ],
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "language": {"type": "string", "minLength": 1},
                "expected_observations": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["kind", "symbol", "resource", "method", "line"],
                    "properties": {
                      "kind": {
                        "enum": ["db_write", "message_publish", "other_method_call"]
                      },
                      "symbol": {"type": "string", "minLength": 1},
                      "resource": {"type": "string", "minLength": 1},
                      "method": {"type": "string", "minLength": 1},
                      "line": {"type": "integer", "minimum": 1}
                    },
                    "additionalProperties": false
                  }
                },
                "expected_framework_candidates": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "framework",
                      "symbol",
                      "resource",
                      "method",
                      "line",
                      "suggested_kind",
                      "method_binding_required"
                    ],
                    "properties": {
                      "framework": {"type": "string", "minLength": 1},
                      "symbol": {"type": "string", "minLength": 1},
                      "resource": {"type": "string", "minLength": 1},
                      "method": {"type": "string", "minLength": 1},
                      "line": {"type": "integer", "minimum": 1},
                      "suggested_kind": {
                        "anyOf": [
                          {"enum": ["db_write", "message_publish"]},
                          {"type": "null"}
                        ]
                      },
                      "method_binding_required": {"type": "boolean"}
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
