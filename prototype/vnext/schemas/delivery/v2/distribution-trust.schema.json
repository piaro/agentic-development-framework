{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-development-kit.dev/schemas/delivery/v2/distribution-trust.schema.json",
  "title": "Attested Framework Distribution Trust v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "keys"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "keys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "algorithm",
          "public_key",
          "allowed_sources",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "algorithm": {
            "const": "ed25519"
          },
          "public_key": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "allowed_sources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "status": {
            "enum": [
              "active",
              "retired",
              "revoked"
            ]
          }
        }
      }
    }
  }
}
