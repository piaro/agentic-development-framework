{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic://schemas/outputs/v1/detector-benchmark-report",
  "type": "object",
  "required": [
    "schema_version",
    "corpus_id",
    "corpus_digest",
    "status",
    "minimum_scores",
    "summary",
    "cases"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "corpus_id": {"type": "string", "minLength": 1},
    "corpus_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "status": {"enum": ["passed", "failed"]},
    "minimum_scores": {
      "type": "object",
      "required": [
        "observation_precision_bps",
        "observation_recall_bps",
        "framework_precision_bps",
        "framework_recall_bps"
      ],
      "properties": {
        "observation_precision_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "observation_recall_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "framework_precision_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
        "framework_recall_bps": {"type": "integer", "minimum": 0, "maximum": 10000}
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "projects",
        "cases",
        "passed_cases",
        "failed_cases",
        "parse_failures",
        "observations",
        "framework_candidates"
      ],
      "properties": {
        "projects": {"type": "integer", "minimum": 1},
        "cases": {"type": "integer", "minimum": 1},
        "passed_cases": {"type": "integer", "minimum": 0},
        "failed_cases": {"type": "integer", "minimum": 0},
        "parse_failures": {"type": "integer", "minimum": 0},
        "observations": {
          "type": "object",
          "required": ["expected", "detected", "matched", "precision_bps", "recall_bps"],
          "properties": {
            "expected": {"type": "integer", "minimum": 0},
            "detected": {"type": "integer", "minimum": 0},
            "matched": {"type": "integer", "minimum": 0},
            "precision_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
            "recall_bps": {"type": "integer", "minimum": 0, "maximum": 10000}
          },
          "additionalProperties": false
        },
        "framework_candidates": {
          "type": "object",
          "required": ["expected", "detected", "matched", "precision_bps", "recall_bps"],
          "properties": {
            "expected": {"type": "integer", "minimum": 0},
            "detected": {"type": "integer", "minimum": 0},
            "matched": {"type": "integer", "minimum": 0},
            "precision_bps": {"type": "integer", "minimum": 0, "maximum": 10000},
            "recall_bps": {"type": "integer", "minimum": 0, "maximum": 10000}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "project_id",
          "path",
          "language",
          "status",
          "parse_error",
          "observations",
          "framework_candidates"
        ],
        "properties": {
          "project_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "language": {"type": "string", "minLength": 1},
          "status": {"enum": ["passed", "failed"]},
          "parse_error": {
            "anyOf": [
              {"type": "string", "minLength": 1},
              {"type": "null"}
            ]
          },
          "observations": {
            "type": "object",
            "required": ["expected", "detected", "matched", "missing", "unexpected"],
            "properties": {
              "expected": {"type": "integer", "minimum": 0},
              "detected": {"type": "integer", "minimum": 0},
              "matched": {"type": "integer", "minimum": 0},
              "missing": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["kind", "symbol", "resource", "method", "line"],
                  "properties": {
                    "kind": {
                      "enum": ["db_write", "message_publish", "other_method_call"]
                    },
                    "symbol": {"type": "string", "minLength": 1},
                    "resource": {"type": "string", "minLength": 1},
                    "method": {"type": "string", "minLength": 1},
                    "line": {"type": "integer", "minimum": 1}
                  },
                  "additionalProperties": false
                }
              },
              "unexpected": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["kind", "symbol", "resource", "method", "line"],
                  "properties": {
                    "kind": {
                      "enum": ["db_write", "message_publish", "other_method_call"]
                    },
                    "symbol": {"type": "string", "minLength": 1},
                    "resource": {"type": "string", "minLength": 1},
                    "method": {"type": "string", "minLength": 1},
                    "line": {"type": "integer", "minimum": 1}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          },
          "framework_candidates": {
            "type": "object",
            "required": ["expected", "detected", "matched", "missing", "unexpected"],
            "properties": {
              "expected": {"type": "integer", "minimum": 0},
              "detected": {"type": "integer", "minimum": 0},
              "matched": {"type": "integer", "minimum": 0},
              "missing": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "framework",
                    "symbol",
                    "resource",
                    "method",
                    "line",
                    "suggested_fact_kinds",
                    "method_binding_required"
                  ],
                  "properties": {
                    "framework": {"type": "string", "minLength": 1},
                    "symbol": {"type": "string", "minLength": 1},
                    "resource": {"type": "string", "minLength": 1},
                    "method": {"type": "string", "minLength": 1},
                    "line": {"type": "integer", "minimum": 1},
                    "suggested_fact_kinds": {
                      "type": "array",
                      "items": {"enum": ["db_write", "external_call", "message_publish", "object_write"]},
                      "uniqueItems": true
                    },
                    "method_binding_required": {"type": "boolean"}
                  },
                  "additionalProperties": false
                }
              },
              "unexpected": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "framework",
                    "symbol",
                    "resource",
                    "method",
                    "line",
                    "suggested_fact_kinds",
                    "method_binding_required"
                  ],
                  "properties": {
                    "framework": {"type": "string", "minLength": 1},
                    "symbol": {"type": "string", "minLength": 1},
                    "resource": {"type": "string", "minLength": 1},
                    "method": {"type": "string", "minLength": 1},
                    "line": {"type": "integer", "minimum": 1},
                    "suggested_fact_kinds": {
                      "type": "array",
                      "items": {"enum": ["db_write", "external_call", "message_publish", "object_write"]},
                      "uniqueItems": true
                    },
                    "method_binding_required": {"type": "boolean"}
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
