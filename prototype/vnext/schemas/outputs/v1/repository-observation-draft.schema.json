{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic://schemas/outputs/v1/repository-observation-draft",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "analysis_roots",
    "source_digests",
    "artifacts",
    "binding_artifacts",
    "next"
  ],
  "properties": {
    "schema_version": {"const": "5"},
    "kind": {"const": "repository-observation-draft"},
    "analysis_roots": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "source_digests": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/observed_artifact"}
    },
    "binding_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/binding_artifact"}
    },
    "next": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "string_list": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "observed_artifact": {
      "type": "object",
      "required": [
        "path",
        "language",
        "detector_status",
        "candidate_ref",
        "symbols",
        "resources",
        "observations",
        "framework_candidates"
      ],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "detector_status": {"type": "string", "enum": ["supported", "unsupported"]},
        "candidate_ref": {"type": "string", "pattern": "^code\\.[A-Za-z0-9._-]+$"},
        "symbols": {"$ref": "#/$defs/string_list"},
        "resources": {"$ref": "#/$defs/string_list"},
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "symbol", "resource", "method", "line"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["db_write", "message_publish", "other_method_call"]
              },
              "symbol": {"type": "string", "minLength": 1},
              "resource": {"type": "string", "minLength": 1},
              "method": {"type": "string", "minLength": 1},
              "line": {"type": "integer", "minimum": 1}
            },
            "additionalProperties": false
          }
        },
        "framework_candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "framework",
              "symbol",
              "resource",
              "method",
              "line",
              "binding_key",
              "suggested_fact_kinds",
              "method_binding_required",
              "review_status",
              "evidence",
              "rationale"
            ],
            "properties": {
              "framework": {"type": "string", "minLength": 1},
              "symbol": {"type": "string", "minLength": 1},
              "resource": {"type": "string", "minLength": 1},
              "method": {"type": "string", "minLength": 1},
              "line": {"type": "integer", "minimum": 1},
              "binding_key": {"type": "string", "minLength": 3},
              "suggested_fact_kinds": {"$ref": "#/$defs/string_list"},
              "method_binding_required": {"type": "boolean"},
              "review_status": {"const": "required"},
              "evidence": {"$ref": "#/$defs/string_list"},
              "rationale": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "binding_artifact": {
      "type": "object",
      "required": ["ref", "path", "language", "bindings"],
      "properties": {
        "ref": {"type": "string", "pattern": "^code\\.[A-Za-z0-9._-]+$"},
        "path": {"type": "string", "minLength": 1},
        "language": {"type": "string", "minLength": 1},
        "bindings": {
          "type": "object",
          "required": ["symbols", "resources", "methods"],
          "properties": {
            "symbols": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["logical_ref", "owner", "authority_ref"],
                "properties": {
                  "logical_ref": {"type": ["string", "null"]},
                  "owner": {"type": ["string", "null"]},
                  "authority_ref": {"type": ["string", "null"]}
                },
                "additionalProperties": false
              }
            },
            "resources": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["logical_refs", "owner", "authority_ref"],
                "properties": {
                  "logical_refs": {
                    "oneOf": [
                      {"type": "null"},
                      {
                        "type": "object",
                        "additionalProperties": {"type": "string", "minLength": 1}
                      }
                    ]
                  },
                  "owner": {"type": ["string", "null"]},
                  "authority_ref": {"type": ["string", "null"]}
                },
                "additionalProperties": false
              }
            },
            "methods": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": ["fact_kinds", "owner", "authority_ref"],
                "properties": {
                  "fact_kinds": {
                    "oneOf": [
                      {"type": "null"},
                      {"$ref": "#/$defs/string_list"}
                    ]
                  },
                  "owner": {"type": ["string", "null"]},
                  "authority_ref": {"type": ["string", "null"]}
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
