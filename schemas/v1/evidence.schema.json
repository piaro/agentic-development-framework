{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adf://schemas/v1/evidence",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "change_id",
    "requirement_instances",
    "method",
    "outcome",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"type": "string", "pattern": "^evidence\\.[A-Za-z0-9._-]+$"},
    "change_id": {"type": "string", "pattern": "^change\\.[A-Za-z0-9._-]+$"},
    "requirement_instances": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "contract_clause_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["contract_clause_ref", "assertion"],
        "properties": {
          "contract_clause_ref": {
            "type": "string",
            "pattern": "^contract\\.[A-Za-z0-9._-]+#[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "assertion": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "git_revision": {"type": "string", "minLength": 1},
    "input_refs": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-fA-F]{64}$"
      }
    },
    "method": {"type": "string", "minLength": 1},
    "condition": {"type": "string", "minLength": 1},
    "outcome": {"type": "string", "enum": ["passed", "failed", "inconclusive"]},
    "summary": {"type": "string", "minLength": 1},
    "artifact": {"type": "object"}
  },
  "additionalProperties": false
}
