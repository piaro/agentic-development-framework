{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adf://schemas/v1/contract",
  "type": "object",
  "required": ["schema_version", "id", "applies_to", "clauses"],
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"type": "string", "pattern": "^contract\\.[A-Za-z0-9._-]+$"},
    "change_id": {"type": "string", "pattern": "^change\\.[A-Za-z0-9._-]+$"},
    "evidence_mode": {
      "type": "string",
      "enum": ["direct", "inherited", "review"]
    },
    "applies_to": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "clauses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
          "text": {"type": "string", "minLength": 1},
          "applies_to": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "authority_ref": {
            "type": "string",
            "pattern": "^decision\\.[A-Za-z0-9._-]+$"
          },
          "evidence_mode": {
            "type": "string",
            "enum": ["direct", "inherited", "review"]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
