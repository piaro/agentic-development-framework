{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adf://schemas/v1/result",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "change_id",
    "action_id",
    "role",
    "result_schema",
    "context_digest",
    "input_refs",
    "output_refs",
    "freshness_refs",
    "payload"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "id": {"type": "string", "pattern": "^result\\.[A-Za-z0-9._-]+$"},
    "change_id": {"type": "string", "pattern": "^change\\.[A-Za-z0-9._-]+$"},
    "action_id": {"type": "string", "pattern": "^action\\.[A-Za-z0-9._-]+$"},
    "role": {
      "type": "string",
      "enum": ["Analyst", "Human", "Builder", "Challenger"]
    },
    "result_schema": {"type": "string", "pattern": "^result\\.[A-Za-z0-9._-]+$"},
    "context_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "input_refs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "output_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "freshness_refs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "execution": {
      "type": "object",
      "required": ["context_bytes"],
      "properties": {
        "context_bytes": {"type": "integer", "minimum": 0},
        "started_at": {"type": "string", "minLength": 1},
        "completed_at": {"type": "string", "minLength": 1},
        "duration_ms": {"type": "integer", "minimum": 0},
        "model": {"type": "string", "minLength": 1},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "payload": {"type": "object"}
  },
  "additionalProperties": false
}
