{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentic://schemas/v1/result-payloads/analysis",
  "x-result-schema": "result.analysis",
  "x-allowed-roles": ["Analyst"],
  "type": "object",
  "required": ["outcomes"],
  "properties": {
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "instance_key",
          "definition_digest",
          "status",
          "summary",
          "basis_refs"
        ],
        "properties": {
          "instance_key": {"type": "string", "minLength": 1},
          "definition_digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "status": {
            "type": "string",
            "enum": ["satisfied", "unsatisfied", "inconclusive"]
          },
          "summary": {"type": "string", "minLength": 1},
          "basis_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "input_refs": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "freshness_refs": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "decision_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question", "known_fact_refs"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(decision-request|question)\\.[A-Za-z0-9._-]+$"
          },
          "question": {"type": "string", "minLength": 1},
          "known_fact_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "impact"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "impact": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "recommendation": {
            "type": "object",
            "required": ["option_id", "reason"],
            "properties": {
              "option_id": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "required_authority": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
