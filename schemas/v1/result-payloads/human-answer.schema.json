{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adf://schemas/v1/result-payloads/human-answer",
  "x-result-schema": "result.human-answer",
  "x-allowed-roles": ["Human"],
  "type": "object",
  "required": ["answers"],
  "properties": {
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["request_id", "selection"],
        "properties": {
          "request_id": {"type": "string", "minLength": 1},
          "selection": {"type": "string", "minLength": 1},
          "actor_ref": {"type": "string", "minLength": 1},
          "answered_at": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
