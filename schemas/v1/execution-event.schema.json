{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-development-framework.dev/schemas/v1/execution-event.schema.json",
  "title": "External execution event v1",
  "anyOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version", "event", "execution_id", "change_id", "action_id",
        "context_digest", "role", "result_schema", "context_bytes", "runner"
      ],
      "properties": {
        "schema_version": {"const": "1"},
        "event": {"const": "started"},
        "execution_id": {"type": "string", "pattern": "^execution\\.[A-Za-z0-9._-]+$"},
        "change_id": {"type": "string", "pattern": "^change\\.[A-Za-z0-9._-]+$"},
        "action_id": {"type": "string", "pattern": "^action\\.[A-Za-z0-9._-]+$"},
        "context_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "role": {"type": "string", "minLength": 1},
        "result_schema": {"type": "string", "minLength": 1},
        "context_bytes": {"type": "integer", "minimum": 0},
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "surface"],
          "properties": {
            "provider": {"type": "string", "minLength": 1},
            "surface": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        },
        "started_at": {"type": "string", "minLength": 1}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "event", "execution_id", "change_id", "status"],
      "properties": {
        "schema_version": {"const": "1"},
        "event": {"const": "completed"},
        "execution_id": {"type": "string", "pattern": "^execution\\.[A-Za-z0-9._-]+$"},
        "change_id": {"type": "string", "pattern": "^change\\.[A-Za-z0-9._-]+$"},
        "status": {"enum": ["succeeded", "failed", "interrupted", "stale"]},
        "result_id": {"type": "string", "pattern": "^result\\.[A-Za-z0-9._-]+$"},
        "completed_at": {"type": "string", "minLength": 1},
        "duration_ms": {"type": "integer", "minimum": 0},
        "model": {"type": "string", "minLength": 1},
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "reasoning_output_tokens": {"type": "integer", "minimum": 0},
        "tool_calls": {"type": "integer", "minimum": 0},
        "retries": {"type": "integer", "minimum": 0},
        "thread_id": {"type": "string", "minLength": 1},
        "exit_code": {"type": "integer"},
        "error_code": {"type": "string", "minLength": 1}
      }
    }
  ]
}
