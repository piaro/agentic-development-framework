{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adf://schemas/ci/v1/contract-health-policy",
  "type": "object",
  "required": ["schema_version", "fail_on"],
  "properties": {
    "schema_version": {"const": "1"},
    "fail_on": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["failed", "stale", "unverified"]
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
