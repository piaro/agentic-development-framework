{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-development-kit.dev/schemas/delivery/v2/release-sources.schema.json",
  "title": "Framework Release Sources v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "base_url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "base_url": {
            "type": "string",
            "anyOf": [
              {
                "pattern": "^https://[^?#]+$"
              },
              {
                "pattern": "^http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(?::[0-9]+)?/[^?#]*$"
              }
            ]
          }
        }
      }
    }
  }
}
