{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-development-framework.dev/schemas/outputs/v1/migration-draft-validation-report.schema.json",
  "title": "Migration Draft Validation Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "source_revision", "issues", "next"],
  "properties": {
    "schema_version": {"const": "1"},
    "status": {"enum": ["valid", "invalid", "blocked"]},
    "source_revision": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "action_id", "message"],
        "properties": {
          "category": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "action_id": {
            "oneOf": [
              {"type": "null"},
              {"type": "string"}
            ]
          },
          "message": {"type": "string", "minLength": 1}
        }
      }
    },
    "next": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "valid"}}},
      "then": {"properties": {"issues": {"maxItems": 0}}},
      "else": {"properties": {"issues": {"minItems": 1}}}
    }
  ]
}
