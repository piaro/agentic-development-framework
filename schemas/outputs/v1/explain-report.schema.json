{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-development-kit.dev/schemas/outputs/v1/explain-report.schema.json",
  "title": "Explain Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "change_id",
    "state",
    "candidates",
    "requirements",
    "authority",
    "next_action",
    "diagnostics"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fingerprint",
          "signal",
          "bindings",
          "evidence_refs",
          "disposition",
          "disposition_result_id",
          "applied_rules",
          "requirement_instances"
        ],
        "properties": {
          "fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "signal": {
            "type": "string",
            "minLength": 1
          },
          "bindings": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "disposition": {
            "enum": [
              "unreviewed",
              "confirmed",
              "applicability-pending",
              "not-applicable"
            ]
          },
          "disposition_result_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "applied_rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "requirement_instances": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instance_key",
          "requirement_id",
          "subject_refs",
          "selected_by",
          "status",
          "satisfaction_basis",
          "blocked_by",
          "result_checks"
        ],
        "properties": {
          "instance_key": {
            "type": "string",
            "minLength": 1
          },
          "requirement_id": {
            "type": "string",
            "minLength": 1
          },
          "subject_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "selected_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "satisfied",
              "unsatisfied"
            ]
          },
          "assurance": {
            "enum": [
              "evidence-backed"
            ]
          },
          "satisfaction_basis": {
            "enum": [
              "all-current-candidates-reviewed",
              "completed-signal-applicability-review",
              "accepted-result-outcome",
              "no-fresh-satisfying-result",
              "current-evidence-recorded",
              "no-current-evidence"
            ]
          },
          "blocked_by": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result_checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "result_id",
                "outcome_status",
                "definition_matches",
                "result_schema_matches",
                "role_matches",
                "stale_refs",
                "accepted"
              ],
              "properties": {
                "result_id": {
                  "type": "string",
                  "minLength": 1
                },
                "outcome_status": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "definition_matches": {
                  "type": "boolean"
                },
                "result_schema_matches": {
                  "type": "boolean"
                },
                "role_matches": {
                  "type": "boolean"
                },
                "stale_refs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "accepted": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    },
    "authority": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request_id",
          "request_result_id",
          "request_stale_refs",
          "status",
          "answer_result_ids",
          "decision_ids",
          "contract_clause_refs"
        ],
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1
          },
          "request_result_id": {
            "type": "string",
            "minLength": 1
          },
          "request_stale_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "open",
              "answered-not-recorded",
              "recorded",
              "stale-request"
            ]
          },
          "answer_result_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decision_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "contract_clause_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "next_action": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "role",
            "action",
            "reason",
            "requirement_instances",
            "candidate_fingerprints"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "role": {
              "type": "string",
              "minLength": 1
            },
            "action": {
              "type": "string",
              "minLength": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "requirement_instances": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "candidate_fingerprints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
