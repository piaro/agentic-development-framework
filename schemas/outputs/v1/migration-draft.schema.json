{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-development-framework.dev/schemas/outputs/v1/migration-draft.schema.json",
  "title": "Migration Draft v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "source_revision",
    "source_state",
    "status",
    "actions",
    "next"
  ],
  "properties": {
    "schema_version": {"const": "2"},
    "kind": {"const": "migration-draft"},
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_state": {"const": "current"},
    "status": {"const": "review-required"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "classification",
          "operation",
          "source_paths",
          "target_paths",
          "items",
          "requires_human_review",
          "instruction",
          "completion_checks",
          "review"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "classification": {
            "enum": [
              "mechanical",
              "review-required",
              "generated",
              "release-supplied"
            ]
          },
          "operation": {
            "enum": [
              "inventory-only",
              "replace-after-review",
              "transform-after-review",
              "generate-from-revision",
              "install-from-release"
            ]
          },
          "source_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "target_paths": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "items": {"type": "integer", "minimum": 0},
          "requires_human_review": {"type": "boolean"},
          "instruction": {"type": "string", "minLength": 1},
          "completion_checks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "review": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["decision", "reviewer", "rationale", "evidence_refs"],
                "properties": {
                  "decision": {
                    "enum": ["proceed", "retire", "preserve-history"]
                  },
                  "reviewer": {"type": "string", "minLength": 1},
                  "rationale": {"type": "string", "minLength": 1},
                  "evidence_refs": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {"type": "string", "minLength": 1}
                  }
                }
              }
            ]
          }
        }
      }
    },
    "next": {"type": "string", "minLength": 1}
  }
}
