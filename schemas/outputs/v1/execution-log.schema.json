{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-development-framework.dev/schemas/outputs/v1/execution-log.schema.json",
  "title": "Execution Log v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "change_id", "entries", "totals"],
  "properties": {
    "schema_version": {"const": "2"},
    "change_id": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "execution_id", "result_id", "action_id", "role", "result_schema",
          "context_bytes", "status", "runner_provider", "runner_surface",
          "runner_version", "duration_ms", "model", "input_tokens",
          "cached_input_tokens", "output_tokens", "reasoning_output_tokens",
          "tool_calls", "retries", "started_at", "completed_at", "thread_id",
          "exit_code", "error_code"
        ],
        "properties": {
          "execution_id": {"type": ["string", "null"], "minLength": 1},
          "result_id": {"type": ["string", "null"], "minLength": 1},
          "action_id": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "result_schema": {"type": "string", "minLength": 1},
          "context_bytes": {"type": "integer", "minimum": 0},
          "status": {"type": ["string", "null"], "minLength": 1},
          "runner_provider": {"type": ["string", "null"], "minLength": 1},
          "runner_surface": {"type": ["string", "null"], "minLength": 1},
          "runner_version": {"type": ["string", "null"], "minLength": 1},
          "duration_ms": {"type": ["integer", "null"], "minimum": 0},
          "model": {"type": ["string", "null"], "minLength": 1},
          "input_tokens": {"type": ["integer", "null"], "minimum": 0},
          "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
          "output_tokens": {"type": ["integer", "null"], "minimum": 0},
          "reasoning_output_tokens": {"type": ["integer", "null"], "minimum": 0},
          "tool_calls": {"type": ["integer", "null"], "minimum": 0},
          "retries": {"type": ["integer", "null"], "minimum": 0},
          "started_at": {"type": ["string", "null"], "minLength": 1},
          "completed_at": {"type": ["string", "null"], "minLength": 1},
          "thread_id": {"type": ["string", "null"], "minLength": 1},
          "exit_code": {"type": ["integer", "null"]},
          "error_code": {"type": ["string", "null"], "minLength": 1}
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions", "context_bytes", "duration_ms", "input_tokens",
        "cached_input_tokens", "output_tokens", "reasoning_output_tokens",
        "tool_calls", "retries", "entries_without_token_counts",
        "incomplete_executions"
      ],
      "properties": {
        "actions": {"type": "integer", "minimum": 0},
        "context_bytes": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": ["integer", "null"], "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "reasoning_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "tool_calls": {"type": ["integer", "null"], "minimum": 0},
        "retries": {"type": ["integer", "null"], "minimum": 0},
        "entries_without_token_counts": {"type": "integer", "minimum": 0},
        "incomplete_executions": {"type": "integer", "minimum": 0}
      }
    }
  }
}
