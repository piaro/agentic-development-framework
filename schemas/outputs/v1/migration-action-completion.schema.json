{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-development-framework.dev/schemas/outputs/v1/migration-action-completion.schema.json",
  "title": "Migration Action Completion v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "action_id",
    "source_revision",
    "draft_digest",
    "review",
    "completed_checks",
    "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "kind": {"const": "migration-action-completion"},
    "action_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "draft_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "rationale", "evidence_refs"],
      "properties": {
        "reviewer": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "completed_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
