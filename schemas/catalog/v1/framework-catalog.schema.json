{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-development-kit.dev/schemas/catalogs/v1/framework-catalog.schema.json",
  "title": "Framework Detection Catalog v1",
  "description": "Non-authoritative framework method hints distributed only as a signed Framework Release asset.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "rules"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "not": {
        "pattern": "^agentic(?:\\.|$)"
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "framework",
          "languages",
          "methods",
          "rationale"
        ],
        "anyOf": [
          {
            "required": ["manifest_markers"]
          },
          {
            "required": ["source_markers"]
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
          },
          "framework": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[-_][a-z0-9]+)*$"
          },
          "languages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "python",
                "javascript",
                "jsx",
                "typescript",
                "tsx",
                "java",
                "kotlin",
                "go",
                "rust",
                "ruby",
                "php",
                "csharp",
                "swift",
                "scala",
                "c",
                "gdscript"
              ]
            }
          },
          "methods": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "manifest_markers": {
            "$ref": "#/$defs/markers"
          },
          "source_markers": {
            "$ref": "#/$defs/markers"
          },
          "receiver_markers": {
            "$ref": "#/$defs/markers"
          },
          "suggested_fact_kinds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "db_write",
                "message_publish",
                "external_call",
                "object_write"
              ]
            }
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "markers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
