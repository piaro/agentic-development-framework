{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adf://schemas/mcp/v1/tool-error",
  "title": "Agentic MCP Tool Error v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "code",
    "message",
    "retryable",
    "details"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "code": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "retryable": {
      "type": "boolean"
    },
    "details": {
      "type": "object"
    }
  }
}
