#!/usr/bin/env python3
"""Repository-local control plane for Agentic Development Kit.

Semantic decisions remain the responsibility of agents and humans. This CLI
validates their artifacts, resolves accepted contracts, builds mutation impact,
and prevents a change from being marked ready or complete while evidence is
missing.
"""

from __future__ import annotations

import argparse
import fnmatch
import hashlib
import re
import sys
from datetime import date
from pathlib import Path
from typing import Any, Iterable
from urllib.parse import urlparse

try:
    import yaml
except ModuleNotFoundError as exc:  # pragma: no cover - environment dependent
    raise SystemExit(
        "PyYAML is required. Install .agentic/runtime/requirements.txt first."
    ) from exc


class AgenticError(Exception):
    """Expected validation or workflow failure."""


KIT_VERSION = "3.0.0"
MATCH_KEYS = ("contexts", "entities", "capabilities", "operations", "interfaces")
AUTHORITY_KINDS = {
    "accepted-contract",
    "issue-requirement",
    "human-decision",
    "accepted-decision",
}
NON_AUTHORITY_KINDS = {
    "agent-inference",
    "challenger-finding",
    "contract-gap",
    "implementation-convenience",
    "existing-code-only",
    "test-only",
}
DECISION_STATUSES = {"pending", "needs-human-decision", "resolved", "accepted"}
ASSESSMENT_RESULTS = {
    "assessing",
    "ready",
    "blocked-contract-decision",
    "blocked-platform-probe",
    "blocked-conflict",
}
DECISION_SCOPES = {"feature-local", "upper-contract"}
DECISION_EFFECTS = {
    "contract-application",
    "specification-extension",
    "implementation-choice",
    "risk-acceptance",
}
CHALLENGE_FINDING_TYPES = {
    "authority-missing",
    "authority-mismatch",
    "authority-conflict",
    "circular-authority",
    "unrecorded-specification-extension",
}


def find_root(start: Path) -> Path:
    current = start.resolve()
    for candidate in (current, *current.parents):
        if (candidate / ".agentic" / "installation.yaml").is_file():
            return candidate
    raise AgenticError(".agentic/installation.yaml が見つかりません")


def load_yaml(path: Path, required: bool = True) -> dict[str, Any]:
    if not path.is_file():
        if required:
            raise AgenticError(f"必要なファイルがありません: {path}")
        return {}
    try:
        value = yaml.safe_load(path.read_text(encoding="utf-8"))
    except yaml.YAMLError as exc:
        raise AgenticError(f"YAMLを読み込めません: {path}: {exc}") from exc
    if value is None:
        return {}
    if not isinstance(value, dict):
        raise AgenticError(f"top level はmappingである必要があります: {path}")
    return value


def write_yaml(path: Path, value: dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    text = yaml.safe_dump(value, allow_unicode=True, sort_keys=False, width=100)
    temporary = path.with_name(f"{path.name}.tmp")
    temporary.write_text(text, encoding="utf-8")
    temporary.replace(path)


def require_fields(value: dict[str, Any], fields: Iterable[str], source: Path) -> list[str]:
    return [f"{source}: {field} がありません" for field in fields if value.get(field) in (None, "")]


def as_list(value: Any) -> list[Any]:
    return value if isinstance(value, list) else []


def nonempty_text(value: Any) -> bool:
    return isinstance(value, str) and bool(value.strip())


def is_web_reference(value: str) -> bool:
    parsed = urlparse(value)
    return parsed.scheme in {"http", "https"} and bool(parsed.netloc)


def safe_repository_path(root: Path, value: str) -> Path | None:
    if not nonempty_text(value) or is_web_reference(value):
        return None
    candidate = (root / value).resolve()
    try:
        candidate.relative_to(root.resolve())
    except ValueError:
        return None
    return candidate


def file_hash(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def semantic_hash(value: dict[str, Any], ignored: set[str] | None = None) -> str:
    normalized = {key: item for key, item in value.items() if key not in (ignored or set())}
    content = yaml.safe_dump(normalized, allow_unicode=True, sort_keys=True).encode("utf-8")
    return hashlib.sha256(content).hexdigest()


def contract_files(root: Path) -> list[Path]:
    base = root / "contracts"
    return sorted(
        path
        for path in base.rglob("*.yaml")
        if path.name != "catalog.yaml" and "_templates" not in path.parts
    )


def load_contracts(root: Path) -> tuple[dict[str, tuple[Path, dict[str, Any]]], list[str]]:
    contracts: dict[str, tuple[Path, dict[str, Any]]] = {}
    errors: list[str] = []
    for path in contract_files(root):
        try:
            value = load_yaml(path)
        except AgenticError as exc:
            errors.append(str(exc))
            continue
        errors.extend(require_fields(value, ("schema_version", "id", "kind", "status", "version"), path))
        contract_id = value.get("id")
        if not isinstance(contract_id, str) or not contract_id:
            continue
        if contract_id in contracts:
            errors.append(f"contract id が重複しています: {contract_id}")
        contracts[contract_id] = (path, value)
    return contracts, errors


def contract_specific_errors(path: Path, value: dict[str, Any]) -> list[str]:
    errors: list[str] = []
    kind = value.get("kind")
    if value.get("status") not in {"proposed", "accepted", "deprecated", "superseded"}:
        errors.append(f"{path}: status が不正です")
    if kind == "feature":
        errors.extend(require_fields(value, ("risk", "outcome", "governing_contracts"), path))
        if not as_list(value.get("governing_contracts")):
            errors.append(f"{path}: feature governing_contracts が空です")
        introduced = value.get("introduced_decisions")
        if not isinstance(introduced, list) or any(not nonempty_text(item) for item in introduced):
            errors.append(f"{path}: introduced_decisionsは空でない文字列の配列である必要があります")
        elif len(introduced) != len(set(introduced)):
            errors.append(f"{path}: introduced_decisionsが重複しています")
    elif kind == "operation":
        errors.extend(require_fields(value, ("preconditions", "mutations", "postconditions", "transaction", "consistency"), path))
        if not as_list(value.get("mutations")):
            errors.append(f"{path}: operation mutations が空です")
    elif kind == "data-invariants":
        invariants = as_list(value.get("invariants"))
        if not invariants:
            errors.append(f"{path}: invariants が空です")
        for invariant in invariants:
            if not isinstance(invariant, dict) or not invariant.get("id") or not invariant.get("statement"):
                errors.append(f"{path}: invariant には id と statement が必要です")
    return errors


def lint_contracts(root: Path) -> list[str]:
    contracts, errors = load_contracts(root)
    for path, value in contracts.values():
        errors.extend(contract_specific_errors(path, value))
        for contract_id in as_list(value.get("governing_contracts")):
            if contract_id not in contracts:
                errors.append(f"{path}: governing contract が存在しません: {contract_id}")
    catalog = load_yaml(root / "contracts" / "catalog.yaml")
    errors.extend(require_fields(catalog, ("schema_version", "contract_roots"), root / "contracts" / "catalog.yaml"))
    return errors


def change_paths(root: Path, change_id: str) -> tuple[Path, Path, Path]:
    base = root / ".agentic" / "changes" / change_id
    return base / "change.yaml", base / "contract-assessment.yaml", root / ".agentic" / "resolved" / f"{change_id}.lock.yaml"


def contract_challenge_path(root: Path, change_id: str) -> Path:
    return root / ".agentic" / "changes" / change_id / "contract-challenge.yaml"


def find_contract_by_artifact(
    root: Path,
    contracts: dict[str, tuple[Path, dict[str, Any]]],
    artifact: str,
) -> tuple[str, Path, dict[str, Any]] | None:
    if artifact in contracts:
        path, value = contracts[artifact]
        return artifact, path, value
    artifact_path = safe_repository_path(root, artifact)
    if artifact_path is None:
        return None
    for contract_id, (path, value) in contracts.items():
        if path.resolve() == artifact_path:
            return contract_id, path, value
    return None


def contains_id(value: Any, wanted: str) -> bool:
    if isinstance(value, dict):
        if str(value.get("id", "")) == wanted:
            return True
        return any(contains_id(item, wanted) for item in value.values())
    if isinstance(value, list):
        return any(contains_id(item, wanted) for item in value)
    return False


def json_pointer_exists(value: Any, pointer: str) -> bool:
    if pointer == "":
        return True
    if not pointer.startswith("/"):
        return False
    current = value
    for raw_part in pointer[1:].split("/"):
        part = raw_part.replace("~1", "/").replace("~0", "~")
        if isinstance(current, dict) and part in current:
            current = current[part]
        elif isinstance(current, list) and part.isdigit() and int(part) < len(current):
            current = current[int(part)]
        else:
            return False
    return True


def yaml_locator_exists(value: dict[str, Any], locator: str) -> bool:
    if locator.startswith("id:"):
        return contains_id(value, locator.removeprefix("id:"))
    if locator.startswith("pointer:"):
        return json_pointer_exists(value, locator.removeprefix("pointer:"))
    return False


def markdown_locator_exists(path: Path, locator: str) -> bool:
    if not path.is_file() or not locator.startswith("heading:"):
        return False
    wanted = locator.removeprefix("heading:").strip().casefold()
    for line in path.read_text(encoding="utf-8").splitlines():
        heading = re.sub(r"^#+\s+", "", line).strip().casefold()
        if heading == wanted and line.startswith("#"):
            return True
    return False


def accepted_decision_record(path: Path) -> bool:
    if not path.is_file():
        return False
    return bool(
        re.search(
            r"(?im)^-\s*status:\s*accepted\s*$",
            path.read_text(encoding="utf-8"),
        )
    )


def authority_contract_ids(
    root: Path,
    assessment: dict[str, Any],
    contracts: dict[str, tuple[Path, dict[str, Any]]],
) -> set[str]:
    selected: set[str] = set()
    for decision in as_list(assessment.get("decisions")):
        if not isinstance(decision, dict):
            continue
        for authority in as_list(decision.get("authorities")):
            if not isinstance(authority, dict) or authority.get("kind") != "accepted-contract":
                continue
            for ref in as_list(authority.get("refs")):
                if not isinstance(ref, dict) or not nonempty_text(ref.get("artifact")):
                    continue
                entry = find_contract_by_artifact(root, contracts, str(ref["artifact"]))
                if entry is not None:
                    selected.add(entry[0])
    return selected


def authority_sources_hash(
    root: Path,
    assessment: dict[str, Any],
    contracts: dict[str, tuple[Path, dict[str, Any]]],
) -> str:
    sources: dict[str, str] = {}
    for decision in as_list(assessment.get("decisions")):
        if not isinstance(decision, dict):
            continue
        for authority in as_list(decision.get("authorities")):
            if not isinstance(authority, dict):
                continue
            kind = authority.get("kind")
            for ref in as_list(authority.get("refs")):
                if not isinstance(ref, dict) or not nonempty_text(ref.get("artifact")):
                    continue
                artifact = str(ref["artifact"])
                if kind == "accepted-contract":
                    entry = find_contract_by_artifact(root, contracts, artifact)
                    if entry is not None:
                        sources[f"contract:{entry[0]}"] = semantic_hash(entry[2])
                elif kind in {"human-decision", "accepted-decision"}:
                    path = safe_repository_path(root, artifact)
                    if path is not None and path.is_file():
                        sources[f"decision:{path.relative_to(root.resolve())}"] = file_hash(path)
    return semantic_hash(sources)


def load_change(root: Path, change_id: str) -> dict[str, Any]:
    change_path, _, _ = change_paths(root, change_id)
    change = load_yaml(change_path)
    if change.get("id") != change_id:
        raise AgenticError(f"change id が一致しません: {change_path}")
    return change


def values_for_match(value: Any) -> set[str]:
    return {str(item) for item in as_list(value)}


def match_reasons(contract: dict[str, Any], affected: dict[str, Any]) -> set[str]:
    """Return mechanical overlap facts without deciding semantic relevance."""
    rules = contract.get("applies_to")
    if not isinstance(rules, dict):
        return set()
    reasons: set[str] = set()
    for key in MATCH_KEYS:
        if values_for_match(rules.get(key)) & values_for_match(affected.get(key)):
            reasons.add(key)
    for pattern in values_for_match(rules.get("paths")):
        if any(fnmatch.fnmatch(path, pattern) for path in values_for_match(affected.get("paths"))):
            reasons.add("paths")
    return reasons


def strict_match(contract: dict[str, Any], affected: dict[str, Any], reasons: set[str]) -> bool:
    """Identify structural identity matches that do not require a semantic choice."""
    if contract.get("kind") == "feature":
        return False
    if contract.get("kind") == "operation" and "operations" in reasons:
        return True
    return "interfaces" in reasons


def selection_hash(
    contracts: dict[str, tuple[Path, dict[str, Any]]], affected: dict[str, Any]
) -> str:
    """Hash contracts participating in discovery, including newly matching contracts."""
    value = {
        contract_id: {
            "kind": contract.get("kind"),
            "status": contract.get("status"),
            "applies_to": contract.get("applies_to"),
        }
        for contract_id, (_, contract) in sorted(contracts.items())
        if contract.get("kind") == "project" or match_reasons(contract, affected)
    }
    return semantic_hash(value)


def expand_governing_contracts(
    selected: set[str], contracts: dict[str, tuple[Path, dict[str, Any]]]
) -> set[str]:
    expanded = set(selected)
    pending = list(selected)
    while pending:
        contract_id = pending.pop()
        entry = contracts.get(contract_id)
        if entry is None:
            continue
        for governing_id in values_for_match(entry[1].get("governing_contracts")):
            if governing_id not in expanded:
                expanded.add(governing_id)
                pending.append(governing_id)
    return expanded


def contract_candidates(
    contracts: dict[str, tuple[Path, dict[str, Any]]],
    affected: dict[str, Any],
    required: set[str],
) -> dict[str, set[str]]:
    return {
        contract_id: reasons
        for contract_id, (_, contract) in contracts.items()
        if contract_id not in required
        and contract.get("kind") != "project"
        and (reasons := match_reasons(contract, affected))
        and not strict_match(contract, affected, reasons)
    }


def assessed_candidates(assessment: dict[str, Any]) -> dict[str, dict[str, Any]]:
    return {
        str(item["id"]): item
        for item in as_list(assessment.get("contract_candidates"))
        if isinstance(item, dict) and item.get("id")
    }


def candidate_errors(
    candidates: dict[str, set[str]], assessment: dict[str, Any]
) -> list[str]:
    errors: list[str] = []
    assessed = assessed_candidates(assessment)
    assessed_ids = [
        str(item["id"])
        for item in as_list(assessment.get("contract_candidates"))
        if isinstance(item, dict) and item.get("id")
    ]
    if len(assessed_ids) != len(set(assessed_ids)):
        errors.append("contract_candidates の id が重複しています")
    for contract_id, reasons in sorted(candidates.items()):
        item = assessed.get(contract_id)
        if item is None:
            errors.append(
                f"contract candidate が未判断です: {contract_id} "
                f"(matched_by: {', '.join(sorted(reasons))})"
            )
            continue
        decision = item.get("decision")
        if decision not in {"included", "excluded"}:
            errors.append(f"contract candidate の decision が不正です: {contract_id}")
        if not isinstance(item.get("reason"), str) or not item["reason"].strip():
            errors.append(f"contract candidate の判断理由がありません: {contract_id}")
        recorded = values_for_match(item.get("matched_by"))
        if recorded != reasons:
            errors.append(
                f"contract candidate の matched_by が古いか不正です: {contract_id}; "
                f"expected {sorted(reasons)}"
            )
    for contract_id in sorted(set(assessed) - set(candidates)):
        errors.append(f"contract candidate は現在の影響範囲に一致しません: {contract_id}")
    return errors


def candidate_report(root: Path, change_id: str) -> dict[str, Any]:
    contracts, errors = load_contracts(root)
    if errors:
        raise AgenticError("contractを読み込めません:\n- " + "\n- ".join(errors))
    change = load_change(root, change_id)
    _, assessment_path, _ = change_paths(root, change_id)
    assessment = load_yaml(assessment_path)
    feature_id = change.get("feature_contract")
    if not isinstance(feature_id, str) or feature_id not in contracts:
        raise AgenticError("change.feature_contract が有効なcontractを参照していません")
    feature = contracts[feature_id][1]
    required = {feature_id}
    required.update(values_for_match(feature.get("governing_contracts")))
    required.update(
        str(item.get("id"))
        for item in as_list(assessment.get("governing_contracts"))
        if isinstance(item, dict) and item.get("id")
    )
    required.update(
        str(ref.get("contract"))
        for decision in as_list(assessment.get("decisions"))
        if isinstance(decision, dict)
        for ref in as_list(decision.get("resulting_contract_refs"))
        if isinstance(ref, dict) and ref.get("contract")
    )
    required.update(authority_contract_ids(root, assessment, contracts))
    affected = change.get("affected") if isinstance(change.get("affected"), dict) else {}
    for contract_id, (_, contract) in contracts.items():
        reasons = match_reasons(contract, affected)
        if contract.get("kind") == "project" or strict_match(contract, affected, reasons):
            required.add(contract_id)
    required = expand_governing_contracts(required, contracts)
    candidates = contract_candidates(contracts, affected, required)
    assessed = assessed_candidates(assessment)
    return {
        "change": change_id,
        "required_contracts": sorted(required),
        "contract_candidates": [
            {
                "id": contract_id,
                "matched_by": sorted(reasons),
                "decision": assessed.get(contract_id, {}).get("decision", "pending"),
                "reason": assessed.get(contract_id, {}).get("reason", ""),
            }
            for contract_id, reasons in sorted(candidates.items())
        ],
    }


def contract_covers(
    contract: dict[str, Any], key: str, value: str, *, kinds: set[str] | None = None
) -> bool:
    if kinds is not None and contract.get("kind") not in kinds:
        return False
    rules = contract.get("applies_to")
    if not isinstance(rules, dict):
        return False
    if key == "paths":
        return any(fnmatch.fnmatch(value, pattern) for pattern in values_for_match(rules.get(key)))
    return value in values_for_match(rules.get(key))


def coverage_errors(
    selected: set[str],
    contracts: dict[str, tuple[Path, dict[str, Any]]],
    affected: dict[str, Any],
    data_change: bool,
) -> list[str]:
    selected_contracts = [
        contracts[contract_id][1]
        for contract_id in selected
        if contract_id in contracts and contracts[contract_id][1].get("kind") != "feature"
    ]
    errors: list[str] = []
    requirements = (
        ("contexts", None, "対象領域"),
        ("entities", None, "Entity"),
        ("capabilities", {"capability"}, "Capability"),
        ("operations", {"operation"}, "Operation"),
        ("interfaces", None, "API/Interface"),
    )
    for key, kinds, label in requirements:
        for value in sorted(values_for_match(affected.get(key))):
            if not any(contract_covers(contract, key, value, kinds=kinds) for contract in selected_contracts):
                errors.append(f"影響対象をcoverするcontractがありません: {label} {value}")
    if data_change:
        for entity in sorted(values_for_match(affected.get("entities"))):
            if not any(
                contract_covers(contract, "entities", entity, kinds={"data-invariants"})
                for contract in selected_contracts
            ):
                errors.append(f"EntityをcoverするData Invariantがありません: {entity}")
    return errors


def decision_request_errors(decision: dict[str, Any]) -> list[str]:
    decision_id = str(decision.get("id", "<unknown>"))
    request = decision.get("request")
    if not isinstance(request, dict):
        return [f"decision {decision_id}: needs-human-decision には request が必要です"]
    errors: list[str] = []
    for field in ("question", "why_now", "required_decider"):
        if not nonempty_text(request.get(field)):
            errors.append(f"decision {decision_id}: request.{field} がありません")
    discovered_by = request.get("discovered_by")
    if not isinstance(discovered_by, dict):
        errors.append(f"decision {decision_id}: request.discovered_by がありません")
    else:
        for field in ("role", "ref"):
            if not nonempty_text(discovered_by.get(field)):
                errors.append(f"decision {decision_id}: request.discovered_by.{field} がありません")
    options = request.get("options")
    option_ids: list[str] = []
    if not isinstance(options, list) or len(options) < 2:
        errors.append(f"decision {decision_id}: request.options には2件以上の選択肢が必要です")
    else:
        for option in options:
            if not isinstance(option, dict):
                errors.append(f"decision {decision_id}: request option がmappingではありません")
                continue
            option_id = option.get("id")
            if not nonempty_text(option_id) or not nonempty_text(option.get("summary")):
                errors.append(f"decision {decision_id}: request option には id と summary が必要です")
                continue
            option_ids.append(str(option_id))
            impact = option.get("impact")
            if not isinstance(impact, list) or not any(nonempty_text(item) for item in impact):
                errors.append(f"decision {decision_id}: option {option_id} に impact がありません")
        if len(option_ids) != len(set(option_ids)):
            errors.append(f"decision {decision_id}: request option id が重複しています")
    recommendation = request.get("recommendation")
    if not isinstance(recommendation, dict) or not nonempty_text(recommendation.get("option")) or not nonempty_text(recommendation.get("reason")):
        errors.append(f"decision {decision_id}: request.recommendation に option と reason が必要です")
    elif str(recommendation["option"]) not in option_ids:
        errors.append(f"decision {decision_id}: request.recommendation.option が選択肢にありません")
    return errors


def authority_errors(
    root: Path,
    decision: dict[str, Any],
    contracts: dict[str, tuple[Path, dict[str, Any]]],
) -> list[str]:
    decision_id = str(decision.get("id", "<unknown>"))
    authorities = decision.get("authorities")
    if not isinstance(authorities, list) or not authorities:
        return [
            f"decision {decision_id}: resolved/accepted decisionにauthorityがありません; "
            "reason、finding、gap、コード、テストはauthorityではありません"
        ]
    errors: list[str] = []
    resulting = {
        (str(item.get("contract")), str(item.get("locator")))
        for item in as_list(decision.get("resulting_contract_refs"))
        if isinstance(item, dict) and item.get("contract") and item.get("locator")
    }
    for authority in authorities:
        if not isinstance(authority, dict):
            errors.append(f"decision {decision_id}: authority entry がmappingではありません")
            continue
        kind = authority.get("kind")
        if kind in NON_AUTHORITY_KINDS:
            errors.append(f"decision {decision_id}: authority kind {kind} は認可源ではありません")
            continue
        if kind not in AUTHORITY_KINDS:
            errors.append(f"decision {decision_id}: authority kind が不正です: {kind}")
            continue
        refs = authority.get("refs")
        if not isinstance(refs, list) or not refs:
            errors.append(f"decision {decision_id}: authority {kind} にrefがありません")
            continue
        if kind == "human-decision":
            if not nonempty_text(authority.get("recorded_by")):
                errors.append(f"decision {decision_id}: human-decision に recorded_by がありません")
            try:
                date.fromisoformat(str(authority.get("recorded_at", "")))
            except ValueError:
                errors.append(f"decision {decision_id}: human-decision の recorded_at が不正です")
        for ref in refs:
            if not isinstance(ref, dict):
                errors.append(f"decision {decision_id}: authority ref がmappingではありません")
                continue
            artifact = ref.get("artifact")
            locator = ref.get("locator")
            if not nonempty_text(artifact) or not nonempty_text(locator):
                errors.append(f"decision {decision_id}: authority refにartifact/locatorがありません")
                continue
            artifact_text = str(artifact)
            locator_text = str(locator)
            if kind == "accepted-contract":
                entry = find_contract_by_artifact(root, contracts, artifact_text)
                if entry is None:
                    errors.append(f"decision {decision_id}: accepted-contractが存在しません: {artifact_text}")
                    continue
                contract_id, _, contract = entry
                if contract.get("status") != "accepted":
                    errors.append(f"decision {decision_id}: authority contractがacceptedではありません: {contract_id}")
                if ref.get("version") != contract.get("version"):
                    errors.append(f"decision {decision_id}: authority contract versionが一致しません: {contract_id}")
                if not yaml_locator_exists(contract, locator_text):
                    errors.append(f"decision {decision_id}: authority contract locatorを解決できません: {contract_id} {locator_text}")
                if (contract_id, locator_text) in resulting:
                    errors.append(f"decision {decision_id}: 新設・変更するclauseを自身のauthorityにはできません: {contract_id} {locator_text}")
            elif kind == "issue-requirement":
                if not is_web_reference(artifact_text) and not artifact_text.startswith("issue:"):
                    errors.append(f"decision {decision_id}: issue-requirement artifactがIssue参照ではありません")
            elif kind in {"human-decision", "accepted-decision"}:
                if is_web_reference(artifact_text):
                    if kind == "accepted-decision":
                        errors.append(f"decision {decision_id}: accepted-decisionはrepository内recordを参照してください")
                    continue
                path = safe_repository_path(root, artifact_text)
                decisions_root = (root / "decisions").resolve()
                if path is None or not path.is_file():
                    errors.append(f"decision {decision_id}: Decision recordが存在しません: {artifact_text}")
                    continue
                try:
                    path.relative_to(decisions_root)
                except ValueError:
                    errors.append(f"decision {decision_id}: Decision recordはdecisions/配下に置いてください")
                if not markdown_locator_exists(path, locator_text):
                    errors.append(f"decision {decision_id}: Decision locatorを解決できません: {artifact_text} {locator_text}")
                if not accepted_decision_record(path):
                    errors.append(f"decision {decision_id}: Decision recordがacceptedではありません: {artifact_text}")
    return errors


def feature_decision_errors(
    feature: dict[str, Any], decisions: list[dict[str, Any]]
) -> list[str]:
    errors: list[str] = []
    introduced = feature.get("introduced_decisions")
    if not isinstance(introduced, list) or any(not nonempty_text(item) for item in introduced):
        return ["Feature Contract introduced_decisions は空でない文字列の配列である必要があります"]
    introduced_ids = [str(item) for item in introduced]
    if len(introduced_ids) != len(set(introduced_ids)):
        errors.append("Feature Contract introduced_decisions が重複しています")
    by_id = {str(item.get("id")): item for item in decisions if item.get("id")}
    expected = {
        decision_id
        for decision_id, decision in by_id.items()
        if decision.get("effect") == "specification-extension"
        and decision.get("status") in {"resolved", "accepted"}
    }
    for decision_id in sorted(expected - set(introduced_ids)):
        errors.append(f"仕様拡張decisionがFeature introduced_decisionsにありません: {decision_id}")
    for decision_id in sorted(set(introduced_ids) - expected):
        errors.append(f"Feature introduced_decisionsがresolvedな仕様拡張decisionを参照していません: {decision_id}")
    return errors


def assessment_structure_errors(
    root: Path,
    change_id: str,
    assessment: dict[str, Any],
    feature: dict[str, Any],
    contracts: dict[str, tuple[Path, dict[str, Any]]],
) -> list[str]:
    errors: list[str] = []
    if assessment.get("schema_version") != 2:
        errors.append("contract-assessment.yaml はschema_version 2への移行が必要です")
    if assessment.get("change") != change_id:
        errors.append("contract-assessment.yaml のchange idが一致しません")
    if assessment.get("result") not in ASSESSMENT_RESULTS:
        errors.append("contract-assessment.yaml のresultが不正です")
    for field in ("governing_contracts", "contract_candidates", "decisions", "contract_gaps", "platform_unknowns", "conflicts"):
        if not isinstance(assessment.get(field), list):
            errors.append(f"contract-assessment.yaml の{field}は配列である必要があります")
    raw_decisions = assessment.get("decisions")
    if not isinstance(raw_decisions, list):
        return errors
    decisions = [item for item in raw_decisions if isinstance(item, dict)]
    if len(decisions) != len(raw_decisions):
        errors.append("assessment decisionはmappingである必要があります")
    ids: list[str] = []
    for decision in decisions:
        decision_id = decision.get("id")
        if not nonempty_text(decision_id):
            errors.append("assessment decisionにidがありません")
            continue
        ids.append(str(decision_id))
        if not nonempty_text(decision.get("statement")):
            errors.append(f"decision {decision_id}: statementがありません")
        if decision.get("scope") not in DECISION_SCOPES:
            errors.append(f"decision {decision_id}: scopeが不正です")
        if decision.get("effect") not in DECISION_EFFECTS:
            errors.append(f"decision {decision_id}: effectが不正です")
        status = decision.get("status")
        if status not in DECISION_STATUSES:
            errors.append(f"decision {decision_id}: statusが不正です")
        if status in {"resolved", "accepted", "needs-human-decision"} and not nonempty_text(decision.get("reason")):
            errors.append(f"decision {decision_id}: reasonがありません")
        if status in {"resolved", "accepted"}:
            errors.extend(authority_errors(root, decision, contracts))
            if decision.get("effect") == "specification-extension":
                refs = decision.get("resulting_contract_refs")
                if not isinstance(refs, list) or not refs:
                    errors.append(f"decision {decision_id}: specification-extensionにresulting_contract_refsがありません")
                else:
                    for ref in refs:
                        if not isinstance(ref, dict) or not nonempty_text(ref.get("contract")) or not nonempty_text(ref.get("locator")):
                            errors.append(f"decision {decision_id}: resulting_contract_refにcontract/locatorがありません")
                            continue
                        entry = contracts.get(str(ref["contract"]))
                        if entry is None or not yaml_locator_exists(entry[1], str(ref["locator"])):
                            errors.append(f"decision {decision_id}: resulting contract locatorを解決できません: {ref}")
        if status == "needs-human-decision":
            errors.extend(decision_request_errors(decision))
    if len(ids) != len(set(ids)):
        errors.append("assessment decision idが重複しています")
    errors.extend(feature_decision_errors(feature, decisions))
    return errors


def assessment_blockers(assessment: dict[str, Any]) -> list[str]:
    blockers: list[str] = []
    for key in ("contract_gaps", "conflicts", "platform_unknowns"):
        if as_list(assessment.get(key)):
            blockers.append(key)
    unresolved = [
        item
        for item in as_list(assessment.get("decisions"))
        if isinstance(item, dict) and item.get("status") not in {"resolved", "accepted"}
    ]
    if unresolved:
        blockers.append("unresolved decisions")
    if any(
        isinstance(item, dict) and item.get("status") == "needs-human-decision"
        for item in as_list(assessment.get("decisions"))
    ):
        blockers.append("human decision requests")
    if assessment.get("result") != "ready":
        blockers.append("assessment result is not ready")
    return blockers


def challenge_required(change: dict[str, Any], assessment: dict[str, Any]) -> bool:
    return change.get("risk") in {"R1", "R2", "R3"} or bool(as_list(assessment.get("decisions")))


def review_contract_ids(
    root: Path,
    change: dict[str, Any],
    assessment: dict[str, Any],
    contracts: dict[str, tuple[Path, dict[str, Any]]],
) -> set[str]:
    selected: set[str] = set()
    feature_id = change.get("feature_contract")
    if isinstance(feature_id, str):
        selected.add(feature_id)
        if feature_id in contracts:
            selected.update(values_for_match(contracts[feature_id][1].get("governing_contracts")))
    selected.update(
        str(item.get("id"))
        for item in as_list(assessment.get("governing_contracts"))
        if isinstance(item, dict) and item.get("id")
    )
    for decision in as_list(assessment.get("decisions")):
        if not isinstance(decision, dict):
            continue
        selected.update(
            str(item.get("contract"))
            for item in as_list(decision.get("resulting_contract_refs"))
            if isinstance(item, dict) and item.get("contract")
        )
    affected = change.get("affected") if isinstance(change.get("affected"), dict) else {}
    for contract_id, (_, contract) in contracts.items():
        if contract.get("kind") == "project" or match_reasons(contract, affected):
            selected.add(contract_id)
    selected.update(authority_contract_ids(root, assessment, contracts))
    return expand_governing_contracts(selected, contracts)


def contract_review_hash(
    contract_ids: set[str], contracts: dict[str, tuple[Path, dict[str, Any]]]
) -> str:
    reviewed = {
        contract_id: {
            key: item
            for key, item in contracts[contract_id][1].items()
            if key != "status"
        }
        for contract_id in sorted(contract_ids)
        if contract_id in contracts
    }
    return semantic_hash(reviewed)


def challenge_input(
    root: Path,
    change_id: str,
    change: dict[str, Any] | None = None,
    assessment: dict[str, Any] | None = None,
    contracts: dict[str, tuple[Path, dict[str, Any]]] | None = None,
) -> dict[str, Any]:
    change_value = change or load_change(root, change_id)
    _, assessment_path, _ = change_paths(root, change_id)
    assessment_value = assessment or load_yaml(assessment_path)
    contract_values = contracts or load_contracts(root)[0]
    contract_ids = review_contract_ids(root, change_value, assessment_value, contract_values)
    return {
        "schema_version": 1,
        "change": change_id,
        "phase": "pre-implementation",
        "challenger": "TODO",
        "independent_context": False,
        "review": {
            "change_sha256": semantic_hash(change_value, {"status"}),
            "assessment_sha256": semantic_hash(assessment_value, {"result"}),
            "contracts_sha256": contract_review_hash(contract_ids, contract_values),
            "authorities_sha256": authority_sources_hash(root, assessment_value, contract_values),
        },
        "reviewed_decisions": sorted(
            str(item.get("id"))
            for item in as_list(assessment_value.get("decisions"))
            if isinstance(item, dict) and item.get("id")
        ),
        "result": "pending",
        "findings": [],
    }


def contract_challenge_errors(
    root: Path,
    change_id: str,
    change: dict[str, Any],
    assessment: dict[str, Any],
    contracts: dict[str, tuple[Path, dict[str, Any]]],
) -> list[str]:
    if not challenge_required(change, assessment):
        return []
    path = contract_challenge_path(root, change_id)
    try:
        challenge = load_yaml(path)
    except AgenticError as exc:
        return [str(exc)]
    errors: list[str] = []
    if challenge.get("schema_version") != 1:
        errors.append("contract-challenge.yaml のschema_versionが不正です")
    if challenge.get("change") != change_id or challenge.get("phase") != "pre-implementation":
        errors.append("contract-challenge.yaml のchange/phaseが一致しません")
    if not nonempty_text(challenge.get("challenger")) or challenge.get("challenger") == "TODO":
        errors.append("実装前Challengerが記録されていません")
    if change.get("risk") in {"R2", "R3"} and challenge.get("independent_context") is not True:
        errors.append("R2/R3の実装前Challengeには独立contextが必要です")
    expected = challenge_input(root, change_id, change, assessment, contracts)
    review = challenge.get("review")
    if not isinstance(review, dict):
        errors.append("contract-challenge.yaml にreview hashがありません")
    else:
        for field, expected_hash in expected["review"].items():
            if review.get(field) != expected_hash:
                errors.append(f"実装前Challengeがstaleです: {field}")
    reviewed = challenge.get("reviewed_decisions")
    if (
        not isinstance(reviewed, list)
        or len(reviewed) != len({str(item) for item in reviewed})
        or {str(item) for item in reviewed} != set(expected["reviewed_decisions"])
    ):
        errors.append("実装前ChallengeがAssessment decisionを網羅していません")
    findings = challenge.get("findings")
    if not isinstance(findings, list):
        errors.append("contract-challenge.yaml のfindingsは配列である必要があります")
        findings = []
    finding_ids: list[str] = []
    decision_ids = set(expected["reviewed_decisions"])
    for finding in findings:
        if not isinstance(finding, dict):
            errors.append("実装前Challenge findingはmappingである必要があります")
            continue
        if not nonempty_text(finding.get("id")):
            errors.append("実装前Challenge findingにidがありません")
        else:
            finding_ids.append(str(finding["id"]))
        if finding.get("type") not in CHALLENGE_FINDING_TYPES:
            errors.append(f"実装前Challenge finding typeが不正です: {finding.get('type')}")
        if finding.get("severity") not in {"blocking", "warning"}:
            errors.append(f"実装前Challenge finding severityが不正です: {finding.get('severity')}")
        if finding.get("type") != "unrecorded-specification-extension" and str(finding.get("decision", "")) not in decision_ids:
            errors.append(f"実装前Challenge findingが有効なdecisionを参照していません: {finding.get('id')}")
    if len(finding_ids) != len(set(finding_ids)):
        errors.append("実装前Challenge finding idが重複しています")
    blocking = [
        item
        for item in findings
        if isinstance(item, dict) and item.get("severity") == "blocking"
    ]
    if blocking:
        errors.append("実装前Challengeにblocking findingがあります")
    if challenge.get("result") != "passed":
        errors.append("実装前Challengeがpassedではありません")
    return errors


def resolve_contracts(root: Path, change_id: str, write: bool = True) -> dict[str, Any]:
    contracts, errors = load_contracts(root)
    errors.extend(lint_contracts(root))
    if errors:
        raise AgenticError("contract lint に失敗しました:\n- " + "\n- ".join(sorted(set(errors))))

    change_path, assessment_path, lock_path = change_paths(root, change_id)
    change = load_yaml(change_path)
    assessment = load_yaml(assessment_path)
    feature_id = change.get("feature_contract")
    if not isinstance(feature_id, str) or feature_id not in contracts:
        raise AgenticError("change.feature_contract が有効なcontractを参照していません")
    feature = contracts[feature_id][1]
    if feature.get("kind") != "feature":
        raise AgenticError("change.feature_contract はfeature contractではありません")
    errors = assessment_structure_errors(root, change_id, assessment, feature, contracts)
    if errors:
        raise AgenticError("Contract Readiness Assessment の構造が不正です:\n- " + "\n- ".join(errors))
    blockers = assessment_blockers(assessment)
    if blockers:
        raise AgenticError(
            "Contract Readiness Assessment が未解決です: "
            + ", ".join(blockers)
            + "; change statusとassessment resultはblocked-contract-decisionにしてください"
        )
    errors = contract_challenge_errors(root, change_id, change, assessment, contracts)
    if errors:
        raise AgenticError("実装前Contract Challengeに失敗しました:\n- " + "\n- ".join(errors))

    required: set[str] = {feature_id}
    required.update(str(item) for item in as_list(feature.get("governing_contracts")))
    required.update(
        str(item.get("id"))
        for item in as_list(assessment.get("governing_contracts"))
        if isinstance(item, dict) and item.get("id")
    )
    required.update(
        str(ref.get("contract"))
        for decision in as_list(assessment.get("decisions"))
        if isinstance(decision, dict)
        for ref in as_list(decision.get("resulting_contract_refs"))
        if isinstance(ref, dict) and ref.get("contract")
    )
    required.update(authority_contract_ids(root, assessment, contracts))
    affected = change.get("affected") if isinstance(change.get("affected"), dict) else {}
    for contract_id, (_, contract) in contracts.items():
        reasons = match_reasons(contract, affected)
        if contract.get("kind") == "project" or strict_match(contract, affected, reasons):
            required.add(contract_id)
    required = expand_governing_contracts(required, contracts)

    candidates = contract_candidates(contracts, affected, required)
    errors = candidate_errors(candidates, assessment)
    if errors:
        raise AgenticError("Contract候補のAssessmentが未完了です:\n- " + "\n- ".join(errors))

    assessed = assessed_candidates(assessment)
    selected = set(required)
    selected.update(
        contract_id
        for contract_id in candidates
        if assessed[contract_id].get("decision") == "included"
    )
    selected = expand_governing_contracts(selected, contracts)

    errors = coverage_errors(selected, contracts, affected, bool(change.get("data_change")))
    if errors:
        raise AgenticError("影響対象のContract coverageが不足しています:\n- " + "\n- ".join(errors))

    unresolved: list[str] = []
    resolved: list[dict[str, Any]] = []
    for contract_id in sorted(selected):
        entry = contracts.get(contract_id)
        if entry is None:
            unresolved.append(contract_id)
            continue
        path, value = entry
        if value.get("status") != "accepted":
            unresolved.append(f"{contract_id} ({value.get('status')})")
            continue
        resolved.append(
            {
                "id": contract_id,
                "kind": value.get("kind"),
                "version": value.get("version"),
                "path": str(path.relative_to(root)),
                "sha256": file_hash(path),
            }
        )
    if unresolved:
        raise AgenticError("解決できないcontractがあります: " + ", ".join(unresolved))

    kinds = {item["kind"] for item in resolved}
    data_change = bool(change.get("data_change"))
    if data_change:
        missing = {"data-invariants", "operation"} - kinds
        if missing:
            raise AgenticError("データ変更に必要なcontract kindがありません: " + ", ".join(sorted(missing)))

    lock = {
        "schema_version": 2,
        "authority_model_version": 1,
        "change": change_id,
        "generated_at": date.today().isoformat(),
        "change_sha256": semantic_hash(change, {"status"}),
        "assessment_sha256": semantic_hash(assessment),
        "contract_challenge_sha256": semantic_hash(load_yaml(contract_challenge_path(root, change_id)))
        if challenge_required(change, assessment)
        else None,
        "contract_selection_sha256": selection_hash(contracts, affected),
        "contracts": resolved,
        "excluded_contracts": [
            {
                "id": contract_id,
                "sha256": file_hash(contracts[contract_id][0]),
                "reason": assessed[contract_id]["reason"],
            }
            for contract_id in sorted(candidates)
            if assessed[contract_id].get("decision") == "excluded"
        ],
        "unresolved": [],
        "deviations": as_list(feature.get("deviations")),
        "ready": True,
    }
    if write:
        write_yaml(lock_path, lock)
    return lock


def verify_lock(root: Path, change_id: str) -> list[str]:
    change_path, assessment_path, lock_path = change_paths(root, change_id)
    lock = load_yaml(lock_path)
    errors: list[str] = []
    change = load_yaml(change_path)
    assessment = load_yaml(assessment_path)
    contracts, contract_errors = load_contracts(root)
    if lock.get("schema_version") != 2 or lock.get("authority_model_version") != 1:
        errors.append("resolved lockはauthority model検証済みのschema_version 2へ再resolveしてください")
    if contract_errors:
        errors.extend(contract_errors)
    feature_id = change.get("feature_contract")
    if not contract_errors and isinstance(feature_id, str) and feature_id in contracts:
        feature = contracts[feature_id][1]
        errors.extend(assessment_structure_errors(root, change_id, assessment, feature, contracts))
        errors.extend(contract_challenge_errors(root, change_id, change, assessment, contracts))
    affected = change.get("affected") if isinstance(change.get("affected"), dict) else {}
    if not contract_errors and lock.get("contract_selection_sha256") != selection_hash(contracts, affected):
        errors.append("contractの追加・削除・適用条件変更によりresolved lockがstaleです")
    if lock.get("change_sha256") != semantic_hash(change, {"status"}):
        errors.append("change.yaml の変更によりresolved lockがstaleです")
    if lock.get("assessment_sha256") != semantic_hash(assessment):
        errors.append("contract-assessment.yaml の変更によりresolved lockがstaleです")
    if challenge_required(change, assessment):
        challenge_path = contract_challenge_path(root, change_id)
        if not challenge_path.is_file() or lock.get("contract_challenge_sha256") != semantic_hash(load_yaml(challenge_path)):
            errors.append("contract-challenge.yaml の変更によりresolved lockがstaleです")
    for item in as_list(lock.get("contracts")):
        if not isinstance(item, dict) or not item.get("path"):
            errors.append("resolved contract entryが不正です")
            continue
        path = root / str(item["path"])
        if not path.is_file() or item.get("sha256") != file_hash(path):
            errors.append(f"contractの変更によりresolved lockがstaleです: {item.get('id')}")
    for item in as_list(lock.get("excluded_contracts")):
        if not isinstance(item, dict) or not item.get("id"):
            errors.append("excluded contract entryが不正です")
            continue
        entry = contracts.get(str(item["id"]))
        if entry is None or item.get("sha256") != file_hash(entry[0]):
            errors.append(f"除外したcontractの変更によりresolved lockがstaleです: {item.get('id')}")
    return errors


def active_changes(root: Path) -> list[dict[str, Any]]:
    value = load_yaml(root / ".agentic" / "active-changes.yaml", required=False)
    return [item for item in as_list(value.get("changes")) if isinstance(item, dict)]


def operation_mutations(contracts: dict[str, tuple[Path, dict[str, Any]]]) -> tuple[dict[str, dict[str, set[str]]], dict[str, set[str]]]:
    entities: dict[str, dict[str, set[str]]] = {}
    operation_entities: dict[str, set[str]] = {}
    for contract_id, (_, value) in contracts.items():
        if value.get("kind") != "operation" or value.get("status") != "accepted":
            continue
        touched: set[str] = set()
        for mutation in as_list(value.get("mutations")):
            if not isinstance(mutation, dict) or not mutation.get("entity"):
                continue
            entity = str(mutation["entity"])
            touched.add(entity)
            entities.setdefault(entity, {"writers": set(), "actions": set()})["writers"].add(contract_id)
            if mutation.get("action"):
                entities[entity]["actions"].add(str(mutation["action"]))
        operation_entities[contract_id] = touched
    return entities, operation_entities


def build_mutation_graph(root: Path, write: bool = True) -> dict[str, Any]:
    contracts, errors = load_contracts(root)
    if errors:
        raise AgenticError("contractを読み込めません:\n- " + "\n- ".join(errors))
    entities, operation_entities = operation_mutations(contracts)
    changes = active_changes(root)
    conflicts: list[dict[str, Any]] = []
    for index, left in enumerate(changes):
        if left.get("status") in {"complete", "cancelled"}:
            continue
        left_entities = set().union(*(operation_entities.get(str(op), set()) for op in as_list(left.get("operations"))))
        for right in changes[index + 1 :]:
            if right.get("status") in {"complete", "cancelled"}:
                continue
            right_entities = set().union(*(operation_entities.get(str(op), set()) for op in as_list(right.get("operations"))))
            overlap = sorted(left_entities & right_entities)
            if overlap:
                conflicts.append({"changes": [left.get("id"), right.get("id")], "entities": overlap})
    graph = {
        "schema_version": 1,
        "generated_at": date.today().isoformat(),
        "entities": {
            entity: {"writers": sorted(data["writers"]), "actions": sorted(data["actions"])}
            for entity, data in sorted(entities.items())
        },
        "active_change_conflicts": conflicts,
    }
    if write:
        write_yaml(root / ".agentic" / "generated" / "mutation-graph.yaml", graph)
    return graph


def mark_ready(root: Path, change_id: str) -> None:
    change_path, _, _ = change_paths(root, change_id)
    change = load_change(root, change_id)
    errors = verify_lock(root, change_id)
    if errors:
        raise AgenticError("\n- ".join(errors))
    graph = build_mutation_graph(root)
    active = active_changes(root)
    entry = next((item for item in active if item.get("id") == change_id), None)
    if entry is None:
        raise AgenticError("changeが.agentic/active-changes.yamlに登録されていません")
    affected = change.get("affected") if isinstance(change.get("affected"), dict) else {}
    declared_operations = values_for_match(affected.get("operations"))
    active_operations = values_for_match(entry.get("operations"))
    if change.get("data_change") and not declared_operations:
        raise AgenticError("データ変更にaffected.operationsがありません")
    if not declared_operations.issubset(active_operations):
        raise AgenticError("active changeにOperation Contractの登録漏れがあります")
    related = [
        item
        for item in as_list(graph.get("active_change_conflicts"))
        if change_id in as_list(item.get("changes"))
    ]
    if related:
        raise AgenticError("active changeとのmutation競合があります: " + str(related))
    change["status"] = "ready"
    write_yaml(change_path, change)
    entry["status"] = "ready"
    write_yaml(root / ".agentic" / "active-changes.yaml", {"schema_version": 1, "changes": active})


def check_evidence(root: Path, change_id: str) -> list[str]:
    base = root / "evidence" / change_id
    index = load_yaml(base / "index.yaml")
    change = load_change(root, change_id)
    challenge_required = change.get("risk") in {"R2", "R3"}
    challenge = load_yaml(base / "challenge.yaml", required=challenge_required)
    errors: list[str] = verify_lock(root, change_id)
    if index.get("change") != change_id or (challenge and challenge.get("change") != change_id):
        errors.append("evidenceのchange idが一致しません")
    if challenge and challenge.get("result") not in {"passed", "accepted-with-risk"}:
        errors.append("Challenger結果が完了していません")
    if challenge_required and challenge.get("independent_context") is not True:
        errors.append("R2/R3には独立したChallengerが必要です")
    requirements = [item for item in as_list(index.get("requirements")) if isinstance(item, dict)]
    verified_ids = {str(item.get("id")) for item in requirements if item.get("status") == "verified"}
    contracts, _ = load_contracts(root)
    feature_id = change.get("feature_contract")
    if isinstance(feature_id, str) and feature_id in contracts:
        feature = contracts[feature_id][1]
        for requirement_id in values_for_match(feature.get("evidence_requirements")):
            if requirement_id not in verified_ids:
                errors.append(f"Feature Contractのevidenceがありません: {requirement_id}")
    for requirement in requirements:
        if not isinstance(requirement, dict) or requirement.get("status") != "verified":
            errors.append(f"未検証のevidenceがあります: {requirement}")
    for risk in as_list(index.get("residual_risks")):
        if not isinstance(risk, dict) or not risk.get("acceptor") or not risk.get("due"):
            errors.append(f"残存リスクにacceptor/dueがありません: {risk}")
    return errors


def repository_change_ids(root: Path) -> list[str]:
    base = root / ".agentic" / "changes"
    if not base.is_dir():
        return []
    return sorted(path.name for path in base.iterdir() if path.is_dir())


def active_workflow_change_ids(root: Path) -> list[str]:
    active_path = root / ".agentic" / "active-changes.yaml"
    if not active_path.is_file():
        return repository_change_ids(root)
    return sorted(
        str(item.get("id"))
        for item in active_changes(root)
        if item.get("id") and item.get("status") not in {"complete", "cancelled"}
    )


def pending_decision_requests(root: Path, change_ids: list[str]) -> list[tuple[str, dict[str, Any]]]:
    requests: list[tuple[str, dict[str, Any]]] = []
    for change_id in change_ids:
        _, assessment_path, _ = change_paths(root, change_id)
        assessment = load_yaml(assessment_path)
        for decision in as_list(assessment.get("decisions")):
            if isinstance(decision, dict) and decision.get("status") == "needs-human-decision":
                requests.append((change_id, decision))
    return requests


def format_decision_requests(requests: list[tuple[str, dict[str, Any]]], markdown: bool) -> str:
    blocks: list[str] = []
    for change_id, decision in requests:
        decision_id = str(decision.get("id", "<unknown>"))
        request = decision.get("request") if isinstance(decision.get("request"), dict) else {}
        options = [item for item in as_list(request.get("options")) if isinstance(item, dict)]
        recommendation = request.get("recommendation") if isinstance(request.get("recommendation"), dict) else {}
        discovered = request.get("discovered_by") if isinstance(request.get("discovered_by"), dict) else {}
        discovery = str(discovered.get("role", "未指定"))
        if discovered.get("ref"):
            discovery += f" ({discovered['ref']})"
        if markdown:
            lines = [
                f"## [{decision_id}] {request.get('question', decision.get('statement', ''))}",
                "",
                f"- Change: `{change_id}`",
                f"- 判断者: {request.get('required_decider', '未指定')}",
                f"- 発見元: {discovery}",
                f"- 必要な理由: {request.get('why_now', decision.get('reason', ''))}",
                "",
                "### 選択肢",
                "",
            ]
            for option in options:
                lines.append(f"- **{option.get('id')} — {option.get('summary')}**")
                for impact in as_list(option.get("impact")):
                    lines.append(f"  - {impact}")
            lines.extend(
                [
                    "",
                    "### 推奨（authorityではありません）",
                    "",
                    f"{recommendation.get('option', '未指定')} — {recommendation.get('reason', '')}",
                ]
            )
        else:
            lines = [
                f"[{decision_id}] {request.get('question', decision.get('statement', ''))}",
                f"Change: {change_id}",
                f"判断が必要な理由: {request.get('why_now', decision.get('reason', ''))}",
                f"発見元: {discovery}",
                "選択肢:",
            ]
            for option in options:
                lines.append(f"  {option.get('id')}. {option.get('summary')}")
                for impact in as_list(option.get("impact")):
                    lines.append(f"     - {impact}")
            lines.extend(
                [
                    f"推奨（authorityではありません）: {recommendation.get('option', '未指定')} — {recommendation.get('reason', '')}",
                    f"判断者: {request.get('required_decider', '未指定')}",
                ]
            )
        blocks.append("\n".join(lines))
    return "\n\n".join(blocks)


def authority_audit(root: Path, change_ids: list[str]) -> list[str]:
    contracts, contract_errors = load_contracts(root)
    findings = list(contract_errors)
    for change_id in change_ids:
        try:
            change = load_change(root, change_id)
            _, assessment_path, lock_path = change_paths(root, change_id)
            assessment = load_yaml(assessment_path)
        except AgenticError as exc:
            findings.append(f"{change_id}: {exc}")
            continue
        feature_id = change.get("feature_contract")
        if not isinstance(feature_id, str) or feature_id not in contracts:
            findings.append(f"{change_id}: feature contractを解決できません")
            continue
        for error in assessment_structure_errors(root, change_id, assessment, contracts[feature_id][1], contracts):
            findings.append(f"{change_id}: {error}")
        for error in contract_challenge_errors(root, change_id, change, assessment, contracts):
            findings.append(f"{change_id}: {error}")
        if lock_path.is_file():
            lock = load_yaml(lock_path)
            if lock.get("schema_version") != 2 or lock.get("authority_model_version") != 1:
                findings.append(f"{change_id}: legacy resolved lockは再resolveが必要です")
    return findings


def init_change(root: Path, change_id: str, title: str) -> None:
    change_path, assessment_path, _ = change_paths(root, change_id)
    if change_path.exists() or assessment_path.exists():
        raise AgenticError(f"changeは既に存在します: {change_id}")
    feature_id = f"features/{change_id}"
    write_yaml(
        change_path,
        {
            "schema_version": 1,
            "id": change_id,
            "title": title,
            "status": "draft",
            "risk": "R1",
            "data_change": False,
            "affected": {"contexts": [], "entities": [], "capabilities": [], "operations": [], "interfaces": [], "paths": []},
            "feature_contract": feature_id,
        },
    )
    write_yaml(
        assessment_path,
        {
            "schema_version": 2,
            "change": change_id,
            "governing_contracts": [],
            "contract_candidates": [],
            "decisions": [],
            "contract_gaps": [],
            "platform_unknowns": [],
            "conflicts": [],
            "result": "assessing",
        },
    )
    write_yaml(
        contract_challenge_path(root, change_id),
        {
            "schema_version": 1,
            "change": change_id,
            "phase": "pre-implementation",
            "challenger": "TODO",
            "independent_context": False,
            "review": {
                "change_sha256": "TODO",
                "assessment_sha256": "TODO",
                "contracts_sha256": "TODO",
                "authorities_sha256": "TODO",
            },
            "reviewed_decisions": [],
            "result": "pending",
            "findings": [],
        },
    )
    feature_path = root / "contracts" / "features" / f"{change_id}.yaml"
    write_yaml(
        feature_path,
        {
            "schema_version": 2,
            "id": feature_id,
            "kind": "feature",
            "status": "proposed",
            "version": 1,
            "risk": "R1",
            "applies_to": {"contexts": [], "entities": [], "capabilities": [], "operations": [], "interfaces": []},
            "governing_contracts": ["project/constitution"],
            "outcome": "TODO",
            "non_scope": [],
            "introduced_decisions": [],
            "deviations": [],
            "unknowns": [],
            "required_probes": [],
            "evidence_requirements": [],
        },
    )
    active_path = root / ".agentic" / "active-changes.yaml"
    active_value = load_yaml(active_path, required=False) or {"schema_version": 1, "changes": []}
    changes = [item for item in as_list(active_value.get("changes")) if isinstance(item, dict)]
    if not any(item.get("id") == change_id for item in changes):
        changes.append(
            {
                "id": change_id,
                "status": "draft",
                "owner": "unassigned",
                "operations": [],
                "depends_on": [],
                "conflicts_with": [],
            }
        )
    write_yaml(active_path, {"schema_version": 1, "changes": changes})


def main() -> int:
    parser = argparse.ArgumentParser(prog="agentic")
    parser.add_argument("--version", action="version", version=f"%(prog)s {KIT_VERSION}")
    parser.add_argument("--root", type=Path, help="project root")
    groups = parser.add_subparsers(dest="group", required=True)

    contract = groups.add_parser("contract")
    contract_commands = contract.add_subparsers(dest="command", required=True)
    contract_commands.add_parser("lint")
    candidates = contract_commands.add_parser("candidates")
    candidates.add_argument("change_id")
    challenge = contract_commands.add_parser("challenge-input")
    challenge.add_argument("change_id")
    decisions = contract_commands.add_parser("decisions")
    decisions.add_argument("change_id", nargs="?")
    decisions.add_argument("--all", action="store_true", dest="all_changes")
    decisions.add_argument("--format", choices=("text", "markdown"), default="text")
    authority_check = contract_commands.add_parser("authority-check")
    authority_check.add_argument("change_id", nargs="?")
    authority_check.add_argument("--all", action="store_true", dest="all_changes")
    resolve = contract_commands.add_parser("resolve")
    resolve.add_argument("change_id")

    mutation = groups.add_parser("mutation")
    mutation_commands = mutation.add_subparsers(dest="command", required=True)
    mutation_commands.add_parser("build")

    change = groups.add_parser("change")
    change_commands = change.add_subparsers(dest="command", required=True)
    init = change_commands.add_parser("init")
    init.add_argument("change_id")
    init.add_argument("--title", required=True)
    ready = change_commands.add_parser("ready")
    ready.add_argument("change_id")

    evidence = groups.add_parser("evidence")
    evidence_commands = evidence.add_subparsers(dest="command", required=True)
    check = evidence_commands.add_parser("check")
    check.add_argument("change_id")

    args = parser.parse_args()
    root = args.root.resolve() if args.root else find_root(Path.cwd())

    if args.group == "contract" and args.command == "lint":
        errors = lint_contracts(root)
        if errors:
            raise AgenticError("\n- ".join(errors))
        print("contract lint passed")
    elif args.group == "contract" and args.command == "candidates":
        report = candidate_report(root, args.change_id)
        print(yaml.safe_dump(report, allow_unicode=True, sort_keys=False, width=100), end="")
    elif args.group == "contract" and args.command == "challenge-input":
        report = challenge_input(root, args.change_id)
        print(yaml.safe_dump(report, allow_unicode=True, sort_keys=False, width=100), end="")
    elif args.group == "contract" and args.command == "decisions":
        if bool(args.change_id) == bool(args.all_changes):
            raise AgenticError("change_id または --all のどちらか一方を指定してください")
        change_ids = active_workflow_change_ids(root) if args.all_changes else [args.change_id]
        requests = pending_decision_requests(root, change_ids)
        if not requests:
            print("pending decision requests: 0")
        else:
            print(format_decision_requests(requests, args.format == "markdown"))
    elif args.group == "contract" and args.command == "authority-check":
        if bool(args.change_id) == bool(args.all_changes):
            raise AgenticError("change_id または --all のどちらか一方を指定してください")
        change_ids = active_workflow_change_ids(root) if args.all_changes else [args.change_id]
        findings = authority_audit(root, change_ids)
        if findings:
            raise AgenticError("authority migration/checkに失敗しました:\n- " + "\n- ".join(findings))
        print(f"authority check passed for {len(change_ids)} changes")
    elif args.group == "contract" and args.command == "resolve":
        lock = resolve_contracts(root, args.change_id)
        print(f"resolved {len(lock['contracts'])} contracts")
    elif args.group == "mutation" and args.command == "build":
        graph = build_mutation_graph(root)
        print(f"built mutation graph for {len(graph['entities'])} entities")
    elif args.group == "change" and args.command == "init":
        init_change(root, args.change_id, args.title)
        print(f"initialized change {args.change_id}")
    elif args.group == "change" and args.command == "ready":
        mark_ready(root, args.change_id)
        print(f"change {args.change_id} is ready")
    elif args.group == "evidence" and args.command == "check":
        errors = check_evidence(root, args.change_id)
        if errors:
            raise AgenticError("\n- ".join(errors))
        print("evidence check passed")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except AgenticError as exc:
        print(f"error: {exc}", file=sys.stderr)
        raise SystemExit(1) from exc
