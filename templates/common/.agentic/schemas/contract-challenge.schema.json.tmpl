{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piaro.example/agentic/contract-challenge.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "change",
    "phase",
    "challenger",
    "independent_context",
    "review",
    "reviewed_decisions",
    "result",
    "findings"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "change": {"type": "string", "minLength": 1},
    "phase": {"const": "pre-implementation"},
    "challenger": {"type": "string", "minLength": 1},
    "independent_context": {"type": "boolean"},
    "review": {
      "type": "object",
      "required": ["change_sha256", "assessment_sha256", "contracts_sha256", "authorities_sha256"]
    },
    "reviewed_decisions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "result": {"enum": ["pending", "passed", "blocked"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "severity"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {
            "enum": [
              "authority-missing",
              "authority-mismatch",
              "authority-conflict",
              "circular-authority",
              "unrecorded-specification-extension"
            ]
          },
          "decision": {"type": "string"},
          "severity": {"enum": ["blocking", "warning"]},
          "counterexample": {"type": "string"}
        }
      }
    }
  }
}
