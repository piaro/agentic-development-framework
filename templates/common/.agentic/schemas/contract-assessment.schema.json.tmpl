{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piaro.example/agentic/contract-assessment.schema.json",
  "$defs": {
    "sourceRef": {
      "type": "object",
      "required": ["artifact", "locator"],
      "properties": {
        "artifact": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "authority": {
      "type": "object",
      "required": ["kind", "refs"],
      "properties": {
        "kind": {
          "enum": ["accepted-contract", "issue-requirement", "human-decision", "accepted-decision"]
        },
        "refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/sourceRef"},
          "minItems": 1
        },
        "recorded_by": {"type": "string", "minLength": 1},
        "recorded_at": {"type": "string", "format": "date"}
      }
    },
    "decisionRequest": {
      "type": "object",
      "required": ["question", "why_now", "discovered_by", "options", "recommendation", "required_decider"],
      "properties": {
        "question": {"type": "string", "minLength": 1},
        "why_now": {"type": "string", "minLength": 1},
        "discovered_by": {
          "type": "object",
          "required": ["role", "ref"],
          "properties": {
            "role": {"type": "string", "minLength": 1},
            "ref": {"type": "string", "minLength": 1}
          }
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["id", "summary", "impact"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "summary": {"type": "string", "minLength": 1},
              "impact": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1}
            }
          }
        },
        "recommendation": {
          "type": "object",
          "required": ["option", "reason"],
          "properties": {
            "option": {"type": "string", "minLength": 1},
            "reason": {"type": "string", "minLength": 1}
          }
        },
        "required_decider": {"type": "string", "minLength": 1}
      }
    }
  },
  "type": "object",
  "required": [
    "schema_version",
    "change",
    "governing_contracts",
    "contract_candidates",
    "decisions",
    "contract_gaps",
    "platform_unknowns",
    "conflicts",
    "result"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "change": {"type": "string", "minLength": 1},
    "governing_contracts": {"type": "array"},
    "contract_candidates": {"type": "array"},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "scope", "effect", "status"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "scope": {"enum": ["feature-local", "upper-contract"]},
          "effect": {
            "enum": [
              "contract-application",
              "specification-extension",
              "implementation-choice",
              "risk-acceptance"
            ]
          },
          "status": {"enum": ["pending", "needs-human-decision", "resolved", "accepted"]},
          "authorities": {"type": "array", "items": {"$ref": "#/$defs/authority"}},
          "evidence_refs": {"type": "array"},
          "resulting_contract_refs": {"type": "array"},
          "request": {"$ref": "#/$defs/decisionRequest"}
        },
        "allOf": [
          {
            "if": {"properties": {"status": {"enum": ["resolved", "accepted"]}}},
            "then": {"required": ["reason", "authorities"], "properties": {"authorities": {"minItems": 1}}}
          },
          {
            "if": {"properties": {"status": {"const": "needs-human-decision"}}},
            "then": {"required": ["reason", "request"]}
          }
        ]
      }
    },
    "contract_gaps": {"type": "array"},
    "platform_unknowns": {"type": "array"},
    "conflicts": {"type": "array"},
    "result": {
      "enum": ["assessing", "ready", "blocked-contract-decision", "blocked-platform-probe", "blocked-conflict"]
    }
  }
}
