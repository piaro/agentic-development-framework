{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://piaro.example/agentic/change.schema.json",
  "type": "object",
  "required": ["schema_version", "id", "title", "status", "risk", "affected", "feature_contract"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {
      "enum": ["draft", "assessing", "blocked-contract-decision", "blocked-platform-probe", "blocked-conflict", "ready", "building", "challenging", "evidence-pending", "complete", "cancelled"]
    },
    "risk": {"enum": ["R0", "R1", "R2", "R3"]},
    "data_change": {"type": "boolean"}
  }
}
